# Copy to .env and fill in. .env is gitignored.

# --- provider ---------------------------------------------------------------
# openrouter (default) | anthropic | openai | azure_openai | ollama
AAMT_LLM_PROVIDER=openrouter
AAMT_DEVELOPER_MODEL=mistralai/mistral-small-3.2-24b-instruct
AAMT_COORDINATOR_MODEL=mistralai/mistral-small-3.2-24b-instruct
AAMT_REVIEWER_MODEL=mistralai/mistral-small-3.2-24b-instruct
# cheap coder-tuned alternative: qwen/qwen3-coder-30b-a3b-instruct

# --- OpenRouter key pool (rotated round-robin) ----------------------------
# Either a comma-separated list here...
# AAMT_OPENROUTER_API_KEYS=sk-or-v1-aaa,sk-or-v1-bbb,sk-or-v1-ccc
# ...or numbered env vars (auto-collected):
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# --- other providers -----------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- runtime knobs (optional; defaults in aamt/config.py) ---------------
# AAMT_MAX_CONCURRENT_AGENTS=3
# AAMT_MAX_TASK_RETRIES=3
# AAMT_TEST_COMMAND=pytest -q
# AAMT_HUMAN_MODE=APPROVAL
# AAMT_LLM_REQUEST_TIMEOUT_S=120   # cap on one LLM call; a stall becomes a retry, not a hang
