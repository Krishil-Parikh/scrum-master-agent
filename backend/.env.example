# Copy this file to .env and fill in real values. Never commit .env.
#
# OpenRouter API keys -- the client pools every OPENROUTER_API_KEY_N it finds
# and rotates across them (round-robin, with failover on 429/5xx/auth errors).
# One key is enough to run the system; add more to raise your effective
# throughput/rate-limit ceiling.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# Cheap-but-capable Mistral model served via OpenRouter. Swap for any other
# OpenRouter model id -- nothing else in the codebase hardcodes "mistral".
OPENROUTER_MODEL=mistralai/mistral-small-3.2-24b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=AI Dev Pod

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo project git remote (optional). Leave blank to keep the demo project's
# repo fully local under backend/workspace/.
DEMO_PROJECT_GIT_REMOTE=

# SME mode: "human" waits for answers via the API/UI; "auto" answers questions
# itself with an LLM call playing the Business SME role, for unattended runs.
SME_MODE=auto
